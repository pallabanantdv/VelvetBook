  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-velvetbook_session",
        "description": "Encrypted cookie plus authoritative DB revocation/expiry checks. Local HTTP cookie name is velvetbook_session."
      }
    },
    "schemas": {
      "Metadata": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestId", "correlationId"],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "email", "displayName", "emailVerified"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "displayName": {
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ok", "error", "meta"],
        "properties": {
          "ok": {
            "const": false
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": {
                "enum": [
                  "VALIDATION_FAILED",
                  "UNAUTHENTICATED",
                  "ACCESS_DENIED",
                  "RATE_LIMITED",
                  "UNAVAILABLE"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Metadata"
          }
        }
      },
      "Accepted": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accepted"],
        "properties": {
          "accepted": {
            "const": true
          }
        }
      },
      "LoginResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user", "expiresAt"],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CurrentUser": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user", "expiresAt", "mfaVerifiedAt", "memberships"],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "mfaVerifiedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "memberships": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["organizationId", "role"],
              "properties": {
                "organizationId": {
                  "type": "string",
                  "format": "uuid"
                },
                "role": {
                  "enum": ["owner", "manager", "staff", "member"]
                }
              }
            }
          }
        }
      },
      "MfaEnrollment": {
        "type": "object",
        "additionalProperties": false,
        "required": ["secret", "uri"],
        "properties": {
          "secret": {
            "type": "string",
            "description": "Sensitive Base32 secret for enrollment. Never log/cache."
          },
          "uri": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "Registration": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "displayName", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "minLength": 15,
            "maxLength": 72,
            "writeOnly": true,
            "description": "15 characters minimum, 72 UTF-8 bytes maximum; never truncated."
          }
        }
      },
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72,
            "writeOnly": true,
            "description": "15 characters minimum, 72 UTF-8 bytes maximum; never truncated."
          }
        }
      },
      "ResetRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          }
        }
      },
      "ResetCompletion": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token", "password"],
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "writeOnly": true
          },
          "password": {
            "type": "string",
            "minLength": 15,
            "maxLength": 72,
            "writeOnly": true,
            "description": "15 characters minimum, 72 UTF-8 bytes maximum; never truncated."
          }
        }
      },
      "MfaEnrollmentRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["password"],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72,
            "writeOnly": true,
            "description": "15 characters minimum, 72 UTF-8 bytes maximum; never truncated."
          }
        }
      },
      "MfaVerification": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token"],
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "writeOnly": true
          }
        }
      }
    }
  }
}
