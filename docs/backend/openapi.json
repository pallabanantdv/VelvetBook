{
  "openapi": "3.1.0",
  "info": {
    "title": "VelvetBook Authentication API",
    "version": "1.0.0",
    "description": "Phase 2 auth only. No organization, booking or payment business endpoints. Apply reviewed migrations and configure AUTH_ORIGIN/AUTH_SECRET. Local HTTP uses velvetbook_session instead of __Host-velvetbook_session. The reset-password frontend page remains a future client integration."
  },
  "servers": [
    {
      "url": "https://velvetbook.example",
      "description": "Replace with AUTH_ORIGIN."
    }
  ],
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "operationId": "register",
        "summary": "Register ordinary account",
        "tags": ["Authentication"],
        "security": [],
        "responses": {
          "202": {
            "description": "Success; Cache-Control: no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["ok", "data", "meta"],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Accepted"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Metadata"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input/recovery proof. No input values echoed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials/proof or missing/expired/revoked session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origin mismatch, denied scope or factor already enrolled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Shared rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "description": "Currently 60 seconds; account cooldown may be longer."
              }
            }
          },
          "503": {
            "description": "Configuration, persistence or dependency unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "description": "Exact AUTH_ORIGIN, required for every mutation.",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Registration"
              }
            }
          }
        },
        "description": "Identical 202 for new/existing email. No login, owner membership or platform grant."
      }
    },
