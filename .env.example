# PostgreSQL is opt-in; leaving it disabled keeps offline builds working.
# Example shape: postgresql://<user>:<password>@<host>:5432/<database>
# URL query parameters are refused. Configure TLS and pool settings below instead.
# Server-side only: never use a NEXT_PUBLIC_ prefix for database credentials.
DATABASE_URL=

# Long-running Node.js: this maximum applies PER PROCESS, including each replica.
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=15000
# Blank: verify-full in production, disable for local development/test.
# Production forbids disable. Private/custom CA: multiline PEM in DATABASE_SSL_CA.
DATABASE_SSL_MODE=
DATABASE_SSL_CA=

# Separate direct/session connection for a reviewed migration job, not a request.
# db:migrate refuses execution without all three values and matching history.
MIGRATION_DATABASE_URL=
MIGRATION_DATABASE_NAME=
MIGRATION_APPROVED_SHA256=
# Explicit disposable *_test database. db:test never falls back to DATABASE_URL.
TEST_DATABASE_URL=

# Central authentication. Generate a private random secret (64+ characters).
# Required only at request/worker runtime; production requires an HTTPS origin.
AUTH_ORIGIN=http://localhost:3000
AUTH_SECRET=

# Future server-only names. Validated explicitly at bootstrap; no provider selected.
# Never prefix integration credentials with NEXT_PUBLIC_.
PAYMENTS_PROVIDER_API_KEY=
PAYMENTS_PROVIDER_ACCOUNT_REF=
PAYMENTS_WEBHOOK_SIGNING_SECRET=
REFUNDS_PROVIDER_API_KEY=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
MAPS_SERVER_API_KEY=
EMAIL_PROVIDER_API_KEY=
EMAIL_SENDER_PROFILE=
SMS_PROVIDER_API_KEY=
PUSH_SERVICE_CREDENTIALS=
WEBHOOK_REPLAY_WINDOW_SECONDS=
EVENTS_BROKER_URL=

# Proposed operational configuration; blank values use safe architecture defaults.
# DATABASE_ENABLED gates the lazy database bootstrap; other flags validate only.
NODE_ENV=
LOG_LEVEL=
REQUEST_TIMEOUT_MS=
PAGINATION_DEFAULT_LIMIT=
PAGINATION_MAXIMUM_LIMIT=
DATABASE_ENABLED=
PAYMENTS_ENABLED=
STORAGE_ENABLED=
MAPS_ENABLED=
EMAIL_ENABLED=
SMS_ENABLED=
PUSH_ENABLED=
EVENTS_ENABLED=
